# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for the live site.
# Until all four of the first keys are set, the site shows "Payment opens soon".

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# The "service_role" secret (NOT the anon key). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (use test keys first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Razorpay → Account & Settings → Webhooks → secret you choose when adding
# https://<your-site>/api/razorpay/webhook with events payment.captured and payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Signs staff login cookies for /admin (at least 32 random characters; changing it signs everyone out).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to switch the dashboard off. Staff accounts themselves are added with npm run staff:add.
STAFF_SESSION_SECRET=
